# Browser calls go to the same origin (/api/v1) and Next proxies them to the API.
# That keeps session cookies working on both localhost and 127.0.0.1.
# Leave NEXT_PUBLIC_API_URL unset unless you intentionally want a cross-origin API.
# NEXT_PUBLIC_API_URL=/api/v1
API_INTERNAL_URL=http://127.0.0.1:4000/api/v1

# Cloudinary (public cloud name only — never put API secrets in the frontend)
NEXT_PUBLIC_CLOUDINARY_CLOUD_NAME=j8fnep3s
