PORT=4000
# Local embedded Postgres (PGLite) needs pgbouncer=true so Prisma does not use named prepared statements.
# Point this at a normal PostgreSQL URL in shared environments and omit pgbouncer unless you use one.
DATABASE_URL=postgresql://postgres:postgres@127.0.0.1:5433/postgres?connection_limit=1&pgbouncer=true
# Development only. Replace this before any shared or production deployment.
AUTH_SECRET=dev-only-change-me-homestay-by-patricia
CORS_ORIGIN=http://127.0.0.1:3000,http://localhost:3000
COOKIE_SECURE=false

# Optional. Image bytes stay on Cloudinary; the API stores the public URL or public id.
# CLOUDINARY_CLOUD_NAME=
# CLOUDINARY_API_KEY=
# CLOUDINARY_API_SECRET=

# Development seed accounts (created only by prisma/seed.ts, never production users):
# Admin: patricia.dev@homestaybypatricia.test / DevAdmin-Patricia-2026
# Guest: guest.dev@homestaybypatricia.test / DevGuest-Patricia-2026
